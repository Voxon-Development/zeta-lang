package zeta::debug;

import zeta::libc;
import zeta::file.FileWriter;
import zeta::file.File;
import zeta::io_error.IOError;
import zeta::result.Result;

impl str {
    unsafe func from_utf8(bytes: &[]u8): Result<str, Utf8ConversionError> {
        return Result.Ok("");
    }
    unsafe func from_utf8_unchecked(bytes: &[]u8): str {
        return "";
    }

    func as_bytes(&this): &[]u8 {
        unsafe {
            return $reinterpret<&[]u8>(this);
        }
    }
}

struct Utf8ConversionError {}


func debug_panic(msg: str): never {
    let mut w: FileWriter = File.stderr().writer();
    // Best-effort: if writing the panic message itself fails, there's
    // nothing more useful to do than abort anyway.
    let _: Result<usize, IOError> = w.write_all("panic: ".as_bytes());
    let _: Result<usize, IOError> = w.write_all(msg.as_bytes());
    let _: Result<usize, IOError> = w.write_all("\n".as_bytes());
    unsafe { libc.abort(); }
    $unreachable();
}

func assert(cond: bool, msg: str) {
    if (!cond) {
        debug_panic(msg);
    }
}
