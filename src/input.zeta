package zeta::input;

import zeta::utils::array_list.ArrayList;
import zeta::utils::mallocator.Mallocator;
import zeta::utils::mallocator.RawMallocator;

extern "C" func println_int(num: i64);

public struct Inner {
    tag: i64
}

public struct Outer {
    inner: Inner,
    count: i64
}

impl Outer by Drop {
    func drop(mut this) {
        println_int(1);
    }
}

func main(): i64 {
    let alloc: Mallocator = Mallocator {};
    let mut list: ArrayList<Outer, Mallocator> = ArrayList.with_capacity(3, alloc);

    list.push(Outer {
        inner: Inner { tag: 10 },
        count: 100,
    });

    list.push(Outer {
        inner: Inner { tag: 20 },
        count: 200,
    });

    list.push(Outer {
        inner: Inner { tag: 30 },
        count: 300,
    });

    let i: usize = 1;
    let second: &mut Outer = list.get_mut(i);
    let third: &mut Outer = list.get_mut(i + 1);
    second.inner.tag = 123;
    second.count = 456;
    println_int(second.inner.tag);
    third.inner.tag = 789;
    third.count = 999;

    return 0;
}
